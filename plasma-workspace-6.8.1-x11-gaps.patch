+void CursorTheme::setCursorName(qulonglong cursor, const QString &name) const
+{
+#if HAVE_XFIXES
+    if (!haveXfixes()) {
+        return;
+    }
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    if (!x11App || !x11App->display()) {
+        return;
+    }
+    XFixesSetCursorName(x11App->display(), cursor, QFile::encodeName(name).constData());
+#else
+    Q_UNUSED(cursor)
+    Q_UNUSED(name)
+#endif
+}
+
+bool CursorTheme::haveXfixes()
+{
+    bool result = false;
+
+#if HAVE_XFIXES
+    if (!KWindowSystem::isPlatformX11()) {
+        return result;
+    }
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    if (!x11App || !x11App->display()) {
+        return result;
+    }
+    int event_base, error_base;
+    if (XFixesQueryExtension(x11App->display(), &event_base, &error_base)) {
+        int major, minor;
+        XFixesQueryVersion(x11App->display(), &major, &minor);
+        result = (major >= 2);
+    }
+#endif
+
+    return result;
+}
