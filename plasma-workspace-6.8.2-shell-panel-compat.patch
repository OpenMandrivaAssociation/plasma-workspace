diff -ruN a/shell/panelcompat/panelglobal.h b/shell/panelcompat/panelglobal.h
--- a/shell/panelcompat/panelglobal.h	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/panelcompat/panelglobal.h	2026-10-31 20:18:55.134240603 +0100
@@ -0,0 +1,39 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#pragma once
+
+#include <QObject>
+#include <QtQml/qqmlregistration.h>
+
+// Values must match PanelView in shell/panelview.h.
+class PanelGlobal : public QObject
+{
+    Q_OBJECT
+    QML_NAMED_ELEMENT(Global)
+    QML_UNCREATABLE("")
+
+public:
+    enum VisibilityMode {
+        NormalPanel = 0,
+        AutoHide,
+        DodgeWindows,
+        WindowsGoBelow,
+    };
+    Q_ENUM(VisibilityMode)
+
+    enum OpacityMode {
+        Adaptive = 0,
+        Opaque,
+        Translucent,
+    };
+    Q_ENUM(OpacityMode)
+
+    enum LengthMode {
+        FillAvailable = 0,
+        FitContent,
+        Custom,
+    };
+    Q_ENUM(LengthMode)
+};
