 int XCursorTheme::defaultCursorSize() const
 {
+    // Wayland keeps the 6.8 default. X11 follows Xft.dpi, then the display size.
+    if (!KWindowSystem::isPlatformX11()) {
+        return 24;
+    }
+#if HAVE_X11
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    Display *dpy = x11App ? x11App->display() : nullptr;
+    if (!dpy) {
+        return 24;
+    }
+    /* Borrowed from display.c of the Xcursor library. XcursorGetDefaultSize()
+       would return a previously chosen custom size, which is not the default. */
+    int size = 0;
+    int dpi = 0;
+    // The string "v" is owned and will be destroyed by Xlib
+    char *v = XGetDefault(dpy, "Xft", "dpi");
+    if (v) {
+        dpi = atoi(v);
+    }
+    if (dpi) {
+        size = dpi * 16 / 72;
+    }
+    if (size == 0) {
+        int dim;
+        if (DisplayHeight(dpy, DefaultScreen(dpy)) < DisplayWidth(dpy, DefaultScreen(dpy))) {
+            dim = DisplayHeight(dpy, DefaultScreen(dpy));
+        } else {
+            dim = DisplayWidth(dpy, DefaultScreen(dpy));
+        }
+        size = dim / 48;
+    }
+    return size;
+#else
     return 24;
+#endif
+}
+
+qulonglong XCursorTheme::loadCursor(const QString &name, int size) const
+{
+    if (!KWindowSystem::isPlatformX11()) {
+        return 0;
+    }
+#if HAVE_X11
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    if (!x11App || !x11App->display()) {
+        return 0;
+    }
+    if (size <= 0) {
+        size = defaultCursorSize();
+    }
+
+    XcursorImages *images = xcLoadImages(name, size);
+
+    if (!images) {
+        images = xcLoadImages(findAlternative(name), size);
+    }
+
+    if (!images) {
+        return 0;
+    }
+
+    Cursor handle = XcursorImagesLoadCursor(x11App->display(), images);
+    XcursorImagesDestroy(images);
+
+    setCursorName(handle, name);
+    return handle;
+#else
+    Q_UNUSED(name)
+    Q_UNUSED(size)
+    return 0;
+#endif
 }
 
