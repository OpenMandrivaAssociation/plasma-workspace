+// systemd StopUnit returns as soon as the job is queued. If ksmserver's name
+// stays owned, or drkonqi is still up, the service watcher below never quits
+// and SDDM never gets the VT back. Once the X11 session has been up, leave
+// when graphical-session.target is no longer active.
+static void watchGraphicalSessionEnd(QEventLoop &loop, QObject *owner)
+{
+    auto *timer = new QTimer(owner);
+    timer->setInterval(500);
+    auto *state = new QObject(timer);
+    state->setProperty("unitPath", QString());
+    state->setProperty("wasActive", false);
+
+    QObject::connect(timer, &QTimer::timeout, &loop, [state, &loop]() {
+        const bool wasActive = state->property("wasActive").toBool();
+        QString unitPath = state->property("unitPath").toString();
+        if (unitPath.isEmpty()) {
+            auto getUnit = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.systemd1"),
+                                                          QStringLiteral("/org/freedesktop/systemd1"),
+                                                          QStringLiteral("org.freedesktop.systemd1.Manager"),
+                                                          QStringLiteral("GetUnit"));
+            getUnit << QStringLiteral("graphical-session.target");
+            const QDBusReply<QDBusObjectPath> getUnitReply = QDBusConnection::sessionBus().call(getUnit);
+            if (!getUnitReply.isValid()) {
+                if (wasActive) {
+                    qCWarning(PLASMA_STARTUP) << "graphical-session.target disappeared; leaving the X11 session";
+                    loop.quit();
+                }
+                return;
+            }
+            unitPath = getUnitReply.value().path();
+            if (unitPath.isEmpty()) {
+                return;
+            }
+            state->setProperty("unitPath", unitPath);
+        }
+
+        auto getState = QDBusMessage::createMethodCall(QStringLiteral("org.freedesktop.systemd1"),
+                                                       unitPath,
+                                                       QStringLiteral("org.freedesktop.DBus.Properties"),
+                                                       QStringLiteral("Get"));
+        getState << QStringLiteral("org.freedesktop.systemd1.Unit") << QStringLiteral("ActiveState");
+        const QDBusMessage stateReply = QDBusConnection::sessionBus().call(getState);
+        if (stateReply.type() == QDBusMessage::ErrorMessage) {
+            if (wasActive) {
+                qCWarning(PLASMA_STARTUP) << "Could not read graphical-session.target; leaving the X11 session";
+                loop.quit();
+            }
+            return;
+        }
+        const auto arguments = stateReply.arguments();
+        if (arguments.isEmpty() || arguments.at(0).userType() != qMetaTypeId<QDBusVariant>()) {
+            return;
+        }
+        const QString activeState = qdbus_cast<QVariant>(arguments.at(0)).toString();
+        if (activeState == QLatin1String("active") || activeState == QLatin1String("activating") || activeState == QLatin1String("reloading")) {
+            state->setProperty("wasActive", true);
+        } else if (wasActive && (activeState == QLatin1String("inactive") || activeState == QLatin1String("failed"))) {
+            // deactivating is ignored: a restart passes through it, and the next poll sees the result.
+            qCWarning(PLASMA_STARTUP) << "graphical-session.target is" << activeState << "; leaving the X11 session";
+            loop.quit();
+        }
+    });
+    timer->start();
+}
