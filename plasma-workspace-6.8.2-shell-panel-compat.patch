diff -ruN a/shell/panelcompat/CMakeLists.txt b/shell/panelcompat/CMakeLists.txt
--- a/shell/panelcompat/CMakeLists.txt	1970-01-01 01:00:00.000000000 +0100
+++ b/shell/panelcompat/CMakeLists.txt	2026-10-31 20:18:55.132352112 +0100
@@ -0,0 +1,20 @@
+# Compatibility module for QML that still does
+#     import org.kde.plasma.shell.panel 0.1 as Panel
+# and then uses Panel.Global.<enum>. Plasma 6.8 registers those enums only
+# as the Panel type of org.kde.plasma.shell, and that module is backed by
+# the plasmashell executable, so other processes cannot load it.
+
+ecm_add_qml_module(plasmashellpanelplugin
+    URI "org.kde.plasma.shell.panel"
+    VERSION 0.1
+    GENERATE_PLUGIN_SOURCE
+)
+
+target_sources(plasmashellpanelplugin PRIVATE
+    panelglobal.cpp
+    panelglobal.h
+)
+
+target_link_libraries(plasmashellpanelplugin PRIVATE Qt::Qml)
+
+ecm_finalize_qml_module(plasmashellpanelplugin)
