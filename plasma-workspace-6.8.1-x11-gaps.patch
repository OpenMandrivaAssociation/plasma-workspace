+*/
+
+#include "config-X11.h"
+
+#include "cursortheme.h"
+#include "themeapplicator.h"
+
+#include <KWindowSystem>
+
+#include <QFile>
+#include <QGuiApplication>
+
+#if HAVE_X11
+#include "krdb.h"
+
+#include <X11/Xcursor/Xcursor.h>
+#include <X11/Xlib.h>
+#if HAVE_XFIXES
+#include <X11/extensions/Xfixes.h>
+#endif
+#endif
+
+using namespace Qt::StringLiterals;
+
+bool applyTheme(const CursorTheme *theme, const int size)
+{
+    // Wayland applies the saved theme through plasma-setup-xwayland.
+    if (!theme || !KWindowSystem::isPlatformX11()) {
+        return false;
+    }
+
+#if HAVE_X11 && HAVE_XFIXES && XFIXES_MAJOR >= 2 && XCURSOR_LIB_VERSION >= 10105
+    auto *x11App = qGuiApp->nativeInterface<QNativeInterface::QX11Application>();
+    if (!x11App || !x11App->display()) {
+        return false;
+    }
+
+    // Publish Xcursor.theme / Xcursor.size for clients started later.
+    runRdb(0);
+
+    if (!CursorTheme::haveXfixes()) {
+        return true;
+    }
+
+    const QStringList names{
+        u"left_ptr"_s,
+        u"up_arrow"_s,
+        u"cross"_s,
+        u"wait"_s,
+        u"left_ptr_watch"_s,
+        u"ibeam"_s,
+        u"size_ver"_s,
+        u"size_hor"_s,
+        u"size_bdiag"_s,
+        u"size_fdiag"_s,
+        u"size_all"_s,
+        u"split_v"_s,
+        u"split_h"_s,
+        u"pointing_hand"_s,
+        u"openhand"_s,
+        u"closedhand"_s,
+        u"forbidden"_s,
+        u"whats_this"_s,
+        u"copy"_s,
+        u"move"_s,
+        u"link"_s,
+        u"X_cursor"_s,
+        u"right_ptr"_s,
+        u"hand1"_s,
+        u"hand2"_s,
+        u"watch"_s,
+        u"xterm"_s,
+        u"crosshair"_s,
+        u"center_ptr"_s,
+        u"sb_h_double_arrow"_s,
+        u"sb_v_double_arrow"_s,
+        u"fleur"_s,
+        u"top_left_corner"_s,
+        u"top_side"_s,
+        u"top_right_corner"_s,
+        u"right_side"_s,
+        u"bottom_right_corner"_s,
+        u"bottom_side"_s,
+        u"bottom_left_corner"_s,
+        u"left_side"_s,
+        u"question_arrow"_s,
+        u"pirate"_s,
+    };
+
+    for (const QString &name : names) {
+        XFixesChangeCursorByName(x11App->display(), theme->loadCursor(name, size), QFile::encodeName(name).constData());
+    }
+
+    return true;
+#else
+    Q_UNUSED(size)
+    return false;
+#endif
+}
