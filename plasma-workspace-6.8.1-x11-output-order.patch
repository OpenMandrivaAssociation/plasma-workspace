+xcb_window_t X11OutputOrderWatcherPrivate::rootWindow() const
+{
+    const xcb_setup_t *setup = xcb_get_setup(m_x11Interface->connection());
+    return xcb_setup_roots_iterator(setup).data->root;
+}
+
+void X11OutputOrderWatcherPrivate::useFallback(const char *reason)
+{
+    m_orderProtocolPresent = false;
+    if (reason) {
+        qWarning("OutputOrderWatcher may not work as expected. Reason: %s", reason);
+    }
+    if (!m_primaryConnected) {
+        connect(qGuiApp, &QGuiApplication::primaryScreenChanged, this, [this]() {
+            refresh();
+        });
+        m_primaryConnected = true;
+    }
+    m_delayTimer->start();
+}
+
+void X11OutputOrderWatcherPrivate::refreshFromScreens()
+{
+    const QString primaryName = qApp->primaryScreen() ? qApp->primaryScreen()->name() : QString();
+    QStringList pending;
+    const auto screens = qApp->screens();
+    for (QScreen *screen : screens) {
+        if (!screen->name().isEmpty()) {
+            pending.append(screen->name());
+        }
+    }
+    std::ranges::sort(pending, [&primaryName](const QString &left, const QString &right) {
+        if (left == right) {
+            return false;
+        }
+        if (left == primaryName) {
+            return true;
+        }
+        if (right == primaryName) {
+            return false;
+        }
+        return left < right;
+    });
+
+    if (m_outputOrder != pending) {
+        m_outputOrder = pending;
+        Q_EMIT m_watcher->outputOrderChanged(m_outputOrder);
+    }
+}
+
+void X11OutputOrderWatcherPrivate::refresh()
+{
+    if (!m_orderProtocolPresent || !m_x11Interface) {
+        refreshFromScreens();
+        return;
+    }
+
+    QList<std::pair<uint, QString>> orderMap;
+
+    XcbReply<xcb_randr_get_screen_resources_current_reply_t> reply(xcb_randr_get_screen_resources_current_reply(
+        m_x11Interface->connection(),
+        xcb_randr_get_screen_resources_current(m_x11Interface->connection(), rootWindow()),
+        nullptr));
+    if (!reply) {
+        useFallback("XRandr screen resources failed");
+        return;
+    }
+
+    const xcb_timestamp_t timestamp = reply->config_timestamp;
+    const int len = xcb_randr_get_screen_resources_current_outputs_length(reply.get());
+    xcb_randr_output_t *randrOutputs = xcb_randr_get_screen_resources_current_outputs(reply.get());
+
+    for (int i = 0; i < len; ++i) {
+        XcbReply<xcb_randr_get_output_info_reply_t> output(xcb_randr_get_output_info_reply(
+            m_x11Interface->connection(),
+            xcb_randr_get_output_info(m_x11Interface->connection(), randrOutputs[i], timestamp),
+            nullptr));
+
+        if (!output || output->connection == XCB_RANDR_CONNECTION_DISCONNECTED || output->crtc == 0) {
+            continue;
+        }
+
+        const auto orderCookie = xcb_randr_get_output_property(m_x11Interface->connection(),
+                                                                randrOutputs[i],
+                                                                m_kdeScreenAtom,
+                                                                XCB_ATOM_ANY,
+                                                                0,
+                                                                100,
+                                                                false,
+                                                                false);
+        XcbReply<xcb_randr_get_output_property_reply_t> orderReply(
+            xcb_randr_get_output_property_reply(m_x11Interface->connection(), orderCookie, nullptr));
+        // kscreen has not stamped _KDE_SCREEN_INDEX yet. QScreen order is enough
+        // for ScreenPool to create the desktop; a later property notify reorders.
+        if (!orderReply || !(orderReply->type == XCB_ATOM_INTEGER && orderReply->format == 32 && orderReply->num_items == 1)) {
+            useFallback();
+            return;
+        }
+
+        const uint32_t order = *xcb_randr_get_output_property_data(orderReply.get());
+        if (order > 0) {
+            orderMap.emplace_back(order,
+                                  QString::fromUtf8(reinterpret_cast<const char *>(xcb_randr_get_output_info_name(output.get())),
+                                                    xcb_randr_get_output_info_name_length(output.get())));
+        }
+    }
+
+    QSet<QString> orderedNames;
+    for (const auto &entry : orderMap) {
+        orderedNames.insert(entry.second);
+    }
+    QSet<QString> knownNames;
+    const auto screens = qGuiApp->screens();
+    for (const QScreen *screen : screens) {
+        if (!screen->name().isEmpty()) {
+            knownNames.insert(screen->name());
+        }
+    }
+    if (orderedNames != knownNames) {
+        useFallback();
+        return;
+    }
+
+    std::ranges::sort(orderMap);
+    QStringList pendingOutputs;
+    pendingOutputs.reserve(orderMap.size());
+    for (const auto &entry : orderMap) {
+        pendingOutputs.append(entry.second);
+    }
+    if (pendingOutputs != m_outputOrder) {
+        m_outputOrder = pendingOutputs;
+        Q_EMIT m_watcher->outputOrderChanged(m_outputOrder);
+    }
+}
+
+bool X11OutputOrderWatcherPrivate::nativeEventFilter(const QByteArray &eventType, void *message, qintptr *result)
+{
+    Q_UNUSED(result);
+    // Switching the only enabled screen recycles the same QScreen.
+    // https://bugs.kde.org/show_bug.cgi?id=373880
+    if (eventType.isEmpty() || eventType.at(0) != 'x') {
+        return false;
+    }
+
+    auto *event = static_cast<xcb_generic_event_t *>(message);
+    const auto responseType = XCB_EVENT_RESPONSE_TYPE(event);
+    if (responseType != m_xrandrExtensionOffset + XCB_RANDR_NOTIFY) {
+        return false;
+    }
+
+    auto *randrEvent = reinterpret_cast<xcb_randr_notify_event_t *>(event);
+    if (randrEvent->subCode == XCB_RANDR_NOTIFY_OUTPUT_PROPERTY) {
+        if (randrEvent->u.op.atom == m_kdeScreenAtom) {
+            m_orderProtocolPresent = true;
+            roundtrip();
+            m_delayTimer->start();
+        }
+    } else if (randrEvent->subCode == XCB_RANDR_NOTIFY_OUTPUT_CHANGE) {
+        if (randrEvent->u.oc.connection == XCB_RANDR_CONNECTION_DISCONNECTED) {
+            m_delayTimer->start();
+        }
+    }
+    return false;
+}
+
+void X11OutputOrderWatcherPrivate::roundtrip() const
+{
+    const auto cookie = xcb_get_input_focus(m_x11Interface->connection());
+    xcb_generic_error_t *error = nullptr;
+    XcbReply<xcb_get_input_focus_reply_t> sync(xcb_get_input_focus_reply(m_x11Interface->connection(), cookie, &error));
+    if (error) {
+        free(error);
+    }
+}
