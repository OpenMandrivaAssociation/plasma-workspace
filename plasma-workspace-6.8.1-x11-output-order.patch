+// Qt selects the wayland platform plugin ahead of xcb when WAYLAND_DISPLAY is
+// set (including an empty value) or XDG_SESSION_TYPE=wayland. A Wayland greeter
+// or a previous session leaves that in the environment, and a plasmashell
+// started from a tty does not have startplasma-x11's QT_QPA_PLATFORM=xcb.
+// The wayland plugin then fails with "Failed to create wl_display".
+static void selectX11PlatformIfNeeded()
+{
+    const QByteArray sessionType = qgetenv("XDG_SESSION_TYPE");
+    if (sessionType == "wayland") {
+        return;
+    }
+    if (sessionType != "x11" && !qEnvironmentVariableIsSet("DISPLAY")) {
+        return;
+    }
+
+    qunsetenv("WAYLAND_DISPLAY");
+    qunsetenv("WAYLAND_SOCKET");
+    const QByteArray platform = qgetenv("QT_QPA_PLATFORM");
+    if (platform.isEmpty() || platform.startsWith("wayland")) {
+        qputenv("QT_QPA_PLATFORM", "xcb");
+    }
+}
