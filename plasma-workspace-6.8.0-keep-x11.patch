+
+    NETRootInfo ri(X11Info::connection(), NET::WMMoveResize);
+    ri.moveResizeRequest(window, geom.bottomRight().x(), geom.bottomRight().y(), NET::BottomRight, XCB_BUTTON_INDEX_ANY);
